#. TRANSLATORS: H:MM (hours, minutes) to charge the battery. Example: "1:30 to charge"
#: src/device.c:847
#, c-format
msgid "%0d:%02d to charge"
msgstr "%0d:%02d மின்னூட்ட மணி1:30நிமிடங்கள்"

#. TRANSLATORS: H:MM (hours, minutes) to discharge the battery. Example: "1:30 left"
#: src/device.c:852
#, c-format
msgid "%0d:%02d left"
msgstr "%0d:%02d மணி 1.30 நிமிடங்கள் மீதமுள்ளது"

#. TRANSLATORS: "X (hour,hours) Y (minute,minutes) to charge" the battery.
#. Example: "1 hour 10 minutes to charge"
#: src/device.c:887
#, c-format
msgid "%d %s %d %s to charge"
msgstr "%d %s %d %sமின்னூட்டத்திற்கு 1மணி10நிமிடங்கள்உள்ளது"

#: src/device.c:888 src/device.c:906
msgid "hour"
msgid_plural "hours"
msgstr[0] "மணி"
msgstr[1] "மணிகள்"

#: src/device.c:889 src/device.c:896 src/device.c:907
#: src/device.c:914
msgid "minute"
msgid_plural "minutes"
msgstr[0] "நிமிடம்"
msgstr[1] "நிமிடங்கள்"

#. TRANSLATORS: "Y (minute,minutes) to charge" the battery.
#. Example: "59 minutes to charge"
#: src/device.c:895
#, c-format
msgid "%d %s to charge"
msgstr "மின்னூட்டத்திற்கு%d %s59 நிமிடங்கள் உள்ளது"

#. TRANSLATORS: "X (hour,hours) Y (minute,minutes) left" until the battery's empty.
#. Example: "1 hour 10 minutes left"
#: src/device.c:905
#, c-format
msgid "%d %s %d %s left"
msgstr "%d %s %d %s மின்கலம் முழுவதும் தீர 1மணி 10 நிமிடங்கள் மீதம் உள்ளது"

#. TRANSLATORS: "Y (minute,minutes) left" until the battery's empty.
#. Example: "59 minutes left"
#: src/device.c:913
#, c-format
msgid "%d %s left"
msgstr "%d %sமின்கலம் முழுவதும் தீர 59 நிமிடங்கள் மீதம் உள்ளது"

#. TRANSLATORS: example: "battery (charged)"
#: src/device.c:979
#, c-format
msgid "%s (charged)"
msgstr "%s(மின்னூட்டம் நிறைவு)"

#. TRANSLATORS: example: "battery (time remaining)"
#: src/device.c:996
#, c-format
msgid "%s (%s)"
msgstr "%s (%s)மின்கலம் மீதநேரம்"

#. TRANSLATORS: after the icon, a time-remaining string + battery %. Example: "0:59 33%"
#: src/device.c:1071
msgid "%s %.0lf%%"
msgstr "%s%.0lf %%மின்கலம் மீதம் மணி0:59நிமிடம் 33%"

#. TRANSLATORS: after the icon, a time-remaining string + battery %. Example: "(0:59, 33%)"
#: src/device.c:1075
msgid "(%s, %.0lf%%)"
msgstr "(%s,%.0lf %%)மின்கலம் மீதம் மணி0:59நிமிடம் 33%"

#. TRANSLATORS: after the icon, a time-remaining string Example: "0:59"
#: src/device.c:1084
#, c-format
msgid "%s"
msgstr "%sமின்கலம் மணி 0:59நிமிடம்"

#. TRANSLATORS: after the icon, a time-remaining string Example: "(0:59)"
#: src/device.c:1088
#, c-format
msgid "(%s)"
msgstr "(%sமின்கலம் மணி 0:59நிமிடம்)"

#. TRANSLATORS: after the icon, a battery %. Example: "(33%)"
#: src/device.c:1097
msgid "%.0lf%%"
msgstr "%.0lf %%மின்கலம் 33%"

#. TRANSLATORS: after the icon, a battery %. Example: "(33%)"
#: src/device.c:1101
msgid "(%.0lf%%)"
msgstr "(%.0lf %%)மின்கலம் 33%"

#: src/notifier.c:349
msgid "Battery Low"
msgstr "மின்கலம் குறைவு"

#: src/notifier.c:350
msgid "Battery Critical"
msgstr "மின்கலம் நெருக்கடி"

#: src/notifier.c:352
#, c-format
msgid "%.0f%% charge remaining"
msgstr "%.0f %% மின்னேற்றம் மீதம்"

#: src/notifier.c:390
msgid "OK"
msgstr "சரி"

#: src/notifier.c:391
msgid "Battery settings"
msgstr "மின்கலம் அமைப்புகள்"

#: src/service.c:444
msgid "Battery status and power management"
msgstr "மின்கலம் நிலை & ஆற்றல் மேலாண்மை"

#: src/service.c:535
msgid "Charge level"
msgstr "மின்னேற்றம்நிலை"

#: src/service.c:639
msgid "Power Settings…"
msgstr "ஆற்றல் அமைப்புகள்…"

#: src/service.c:665
msgid "Adjust brightness automatically"
msgstr "ஒளிஅளவை தானாகச் சரிசெய்"

#: src/service.c:673
msgid "Flashlight"
msgstr "ஒளிவிளக்கு"

#: src/service.c:679
msgid "Warning: Heavy use can damage the LED!"
msgstr "எச்சரிக்கை: அதீத பயன்பாடு ஒளிஉமிழ் இருமுனையத்தை சேதப்படுத்தலாம்!"

#: src/service.c:687
msgid "Keep screen on"
msgstr "திரையை இயக்கத்தில் வைத்திரு"

#: src/service.c:693
msgid "Battery settings…"
msgstr "மின்கலம் அமைப்புகள்…"

#: src/service.c:845 src/utils.c:68
msgid "Warning"
msgstr "எச்சரிக்கை"

#: src/service.c:846
msgid ""
"The Ayatana Power Indicator does not support evoking the\n"
"power statistics application of your desktop environment, yet.\n"
"\n"
"Please report this to the developers at:\n"
"https://github.com/ArcticaProject/ayatana-indicator-power/issues"
msgstr ""
"உங்கள் மேசைக்கணிணி சூழலின் ஆற்றல் புள்ளிவிவர பயன்பாட்டை தூண்டுவதை\n"
"அயடானா ஆற்றல் குறியீடு இன்னும் ஆதரிக்கவில்லை.\n"
"\n"
"இதை பின்வரும் முகவரியில் மேம்பாட்டாளர்களிடம் அறிக்கை தரவும்:\n"
"https://github.com/arcticaproject/ayatana-indicator-power/issues"

#: src/utils.c:69
msgid ""
"The Ayatana Power Indicator does not support evoking the\n"
"power settings dialog of your desktop environment, yet.\n"
"\n"
"Please report this to the developers at:\n"
"https://github.com/ArcticaProject/ayatana-indicator-power/issues"
msgstr ""
"உங்கள் மேசைக்கணிணி சூழலின் ஆற்றல் அமைப்புஉரையாடலை தூண்டுவதை\n"
"அயடானா ஆற்றல் குறியீடு இன்னும் ஆதரிக்கவில்லை.\n"
"\n"
"இதை பின்வரும் முகவரியில் மேம்பாட்டாளர்களிடம் அறிக்கை தரவும்:\n"
"https://github.com/ArcticaProject/ayatana-indicator-power/issues"
